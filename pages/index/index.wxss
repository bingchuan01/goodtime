/**index.wxss**/
page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

.page-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-top: -80rpx;
}

.fixed-header {
  flex: none;
  overflow: hidden;
  background: linear-gradient(
    135deg,
    rgba(20, 20, 25, 0.88) 0%,
    rgba(30, 30, 38, 0.9) 50%,
    rgba(15, 15, 20, 0.86) 100%
  );
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
}

.header-brand-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx 12rpx;
  min-height: 80rpx;
  box-sizing: border-box;
}

.scrollarea {
  flex: 1;
  height: 0;
}

/* ========== 首页展区：轮播 + 看板双层 ========== */
.hero-zone {
  position: relative;
  width: 100%;
  height: 260rpx;
  overflow: hidden;
  background: #f0f0f0;
}

.home-carousel {
  width: 100%;
  height: 100%;
}

.home-carousel-img {
  width: 100%;
  height: 100%;
  display: block;
}

.home-carousel-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ffeef2 0%, #f3e8ff 100%);
}

.home-carousel-empty-text {
  font-size: 24rpx;
  color: #999;
}

.dashboard-layer {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 100%;
  z-index: 2;
  background: #fff;
  transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  transform: translateY(0);
  will-change: transform;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.dashboard-layer.no-transition {
  transition: none !important;
}

.dashboard-layer.is-collapsed {
  transform: translateY(-100%);
  pointer-events: none;
}

/* 收起后：仅半透明小箭头，不挡轮播视线 */
.dashboard-expand-hint {
  position: absolute;
  top: 10rpx;
  left: 50%;
  z-index: 3;
  width: 56rpx;
  height: 32rpx;
  margin-left: -28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(120, 120, 120, 0.22);
  border-radius: 16rpx;
}

.dashboard-expand-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.85;
}

.project-list {
  display: flex;
  padding: 12rpx 20rpx 20rpx;
}

.home-feed {
  min-height: 200rpx;
}

.project-list .project-column:first-child {
  margin-right: 20rpx;
}

.project-column {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.project-empty {
  padding: 80rpx 40rpx;
  text-align: center;
}

.project-empty .empty-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.project-empty .empty-hint {
  display: block;
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
  margin-bottom: 32rpx;
  padding: 0 20rpx;
}

.project-empty .empty-retry {
  font-size: 28rpx;
  color: #fff;
  background: #FF6B35;
  border: none;
  border-radius: 40rpx;
  padding: 20rpx 60rpx;
}

.project-empty .empty-retry::after {
  border: none;
}

.loading-more {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: #999;
}

.no-more {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: #999;
}

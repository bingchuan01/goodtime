<!--会员权益页（会员中心）-->
<navigation-bar title="会员中心" back="{{false}}" color="white" background="linear-gradient(135deg, #FB7299 0%, #FF9BB5 100%)"></navigation-bar>

<scroll-view class="page-container" scroll-y="{{true}}" bindscroll="onScroll" bindscrolltolower="onScrollToLower">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-card-main">
      <view class="avatar-wrap">
        <image wx:if="{{userInfo && userInfo.avatarUrl}}" class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar avatar-placeholder">头像</view>
      </view>
      <view class="user-meta">
        <view class="nickname">{{userInfo && userInfo.nickname ? userInfo.nickname : '未登录'}}</view>
        <view class="member-level-tag member-level-trial" wx:if="{{isTrial && memberLevelLabel}}">{{memberLevelLabel}}</view>
        <view class="member-level-tag" wx:elif="{{isMember && memberLevelLabel}}">{{memberLevelLabel}}</view>
        <view class="member-status" wx:if="{{isMember}}">会员有效期至 {{memberExpireText}}</view>
        <view class="member-status" wx:elif="{{isTrial}}">体验有效期至 {{memberExpireText}}（可发布项目）</view>
        <view class="member-status member-status-expired" wx:elif="{{memberExpired}}">会员已于 {{memberExpireText}} 到期</view>
        <view class="member-status" wx:else>尚未开通</view>
      </view>
    </view>
    <view class="user-card-action">
      <button class="btn-open" bindtap="goUpgrade" wx:if="{{isMember}}">续费/升级</button>
      <button class="btn-open" bindtap="goUpgrade" wx:elif="{{isTrial}}">升级正式会员</button>
      <button class="btn-open" bindtap="goUpgrade" wx:else>立即开通</button>
    </view>
  </view>

  <!-- 会员权益：语义图标，#FB7299 高纯=已开通 -->
  <view class="section section-benefits">
    <view class="section-title">会员权益</view>
    <view class="section-desc">粉色图标为会员权益；颜色较深、更亮为已开通服务，较淡为筹备中</view>
    <view class="benefits-grid">
      <view class="benefit-cell" wx:for="{{benefitsList}}" wx:key="id">
        <view class="benefit-icon-wrap {{item.enabled ? 'enabled' : 'pending'}}">
          <image class="benefit-icon-img" src="{{item.iconPath}}" mode="aspectFit" />
        </view>
        <text class="benefit-name {{item.enabled ? 'enabled' : ''}}">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 成为他们：层叠轮播 8 张 -->
  <view class="section section-them">
    <view class="section-title">成为他们</view>
    <view class="section-desc">再小的生意 也有自己的品牌</view>
    <view class="carousel-wrap" style="background: {{carouselBg}};">
      <view class="carousel-glass"></view>
      <scroll-view
        class="carousel-scroll"
        scroll-x="{{true}}"
        enable-flex="{{true}}"
        scroll-with-animation
        scroll-left="{{carouselScrollLeft}}"
        bindscroll="onCarouselScroll"
      >
        <view class="carousel-track">
          <view
            class="carousel-item {{carouselIndex === index ? 'active' : ''}}"
            wx:for="{{carouselList}}"
            wx:key="id"
            data-index="{{index}}"
            bindtap="onCarouselTap"
          >
            <view class="carousel-card">
              <image wx:if="{{item.cover}}" class="carousel-image" src="{{item.cover}}" mode="aspectFill" />
              <view wx:else class="carousel-placeholder">{{item.title}}</view>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="carousel-dots">
        <view
          class="dot {{carouselIndex === index ? 'active' : ''}}"
          wx:for="{{carouselList}}"
          wx:key="id"
          data-index="{{index}}"
          bindtap="onCarouselDotTap"
        ></view>
      </view>
    </view>
  </view>

  <!-- 底部占位，避免被吸底按钮遮挡 -->
  <view class="bottom-placeholder"></view>
</scroll-view>

<!-- 吸底：立即开通会员 -->
<view class="footer-bar {{showFooterBar ? 'show' : ''}}">
  <button class="btn-footer" bindtap="goUpgrade" wx:if="{{isMember}}">续费/升级</button>
  <button class="btn-footer" bindtap="goUpgrade" wx:elif="{{isTrial}}">升级正式会员</button>
  <button class="btn-footer" bindtap="goUpgrade" wx:else>立即开通</button>
</view>

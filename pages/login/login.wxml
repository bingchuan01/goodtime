<!--登录页（微信一键登录为主）-->
<navigation-bar title="" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y="true">
  <!-- 头部区域：欢迎语+平台LOGO -->
  <header-logo logo-url="/images/hsjlogo.png"></header-logo>
  <view class="welcome-text">欢迎使用好时机商业品牌小程序</view>
  
  <view class="container">
    <!-- 页面标题 -->
    <view class="page-title">微信快捷登录</view>
    <view class="title-divider"></view>

    <!-- 表单容器 -->
    <view class="form-container">
      <view class="input-group">
        <view class="input-label">提示</view>
        <view class="input">当前版本优先使用微信一键登录</view>
      </view>

      <view class="switch-login">
        <text class="switch-link" bindtap="onCodeLogin">短信验证码登录（即将上线） ></text>
      </view>

      <view class="switch-login">
        <text class="switch-link" bindtap="goToPasswordLogin">账号密码登录（即将上线） ></text>
      </view>

      <!-- 微信一键登录 -->
      <button class="wx-login-btn" bindtap="onWxLogin" loading="{{loading}}" disabled="{{loading || !agreed}}">
        <text class="wx-icon-text">💬</text>
        <text>微信一键登录</text>
      </button>
    </view>

    <!-- 协议勾选 -->
    <view class="agreement-section">
      <checkbox-group bindchange="onAgreementChange">
        <label class="agreement-label">
          <checkbox value="agree" checked="{{agreed}}" class="agreement-checkbox" />
          <view class="agreement-content">
            <text class="agreement-text">我已阅读并同意<text class="link" catchtap="goToAgreement" data-type="user">用户协议</text>、<text class="link" catchtap="goToAgreement" data-type="privacy">隐私政策</text>，完成微信登录后将自动注册</text>
          </view>
        </label>
      </checkbox-group>
    </view>
  </view>
</scroll-view>







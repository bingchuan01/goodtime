.page {
  height: 100vh;
  background: #f5f5f5;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

.balance-bar {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.balance-main {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.balance-links {
  margin-top: 12rpx;
  display: flex;
  gap: 24rpx;
}

.expire-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #e65100;
}

.balance-num {
  font-size: 40rpx;
  font-weight: 600;
  color: #FF6B35;
  flex: 1;
}

.link {
  font-size: 26rpx;
  color: #666;
}

.tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.tab {
  padding: 12rpx 24rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #666;
}

.tab.active {
  background: #FF6B35;
  color: #fff;
}

.product-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
}

.product-desc {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
}

.product-foot {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price {
  color: #FF6B35;
  font-size: 28rpx;
  font-weight: 600;
}

.limit {
  font-size: 22rpx;
  color: #999;
}

.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}

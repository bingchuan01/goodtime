.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.name {
  font-size: 36rpx;
  font-weight: 600;
}

.desc {
  font-size: 28rpx;
  color: #666;
  margin-top: 16rpx;
  line-height: 1.5;
}

.price {
  font-size: 40rpx;
  color: #FF6B35;
  font-weight: 600;
  margin-top: 24rpx;
}

.meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.btn {
  background: #FF6B35;
  color: #fff;
  border-radius: 12rpx;
}

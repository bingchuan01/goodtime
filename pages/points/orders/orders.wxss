.page {
  height: 100vh;
  background: #f5f5f5;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

.item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
}

.title {
  font-size: 28rpx;
  font-weight: 500;
}

.sub {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
}

.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}

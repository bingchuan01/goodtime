.page {
  height: 100vh;
  background: #f5f5f5;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
}

.meta {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
}

.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}

.project-banner {
  background: linear-gradient(135deg, #fff7f0, #fff);
  border: 1rpx solid #ffe0cc;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}

.banner-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.banner-meta {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
}

.btn-use {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #FF6B35;
  background: #fff;
  border: 1rpx solid #FF6B35;
  border-radius: 8rpx;
  padding: 8rpx 24rpx;
  line-height: 1.6;
}

.hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

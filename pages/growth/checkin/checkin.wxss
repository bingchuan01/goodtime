.page {
  height: 100vh;
  background: #f5f5f5;
  padding: 16rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.hero {
  background: linear-gradient(135deg, #FF6B35, #ff8f65);
  border-radius: 16rpx;
  padding: 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
}

.level-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.sv-name {
  font-size: 40rpx;
  font-weight: 600;
}

.exp-text {
  font-size: 28rpx;
  opacity: 0.9;
}

.progress-wrap {
  margin-top: 24rpx;
}

.progress-bar {
  height: 12rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #fff;
  border-radius: 6rpx;
}

.progress-tip {
  font-size: 22rpx;
  margin-top: 8rpx;
  opacity: 0.85;
}

.points-row {
  margin-top: 20rpx;
  display: flex;
  gap: 24rpx;
  font-size: 26rpx;
}

.link {
  text-decoration: underline;
}

.coef-tip {
  font-size: 22rpx;
  margin-top: 12rpx;
  opacity: 0.85;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.streak {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.btn-primary {
  background: #FF6B35;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.btn-primary[disabled] {
  background: #ccc;
  color: #fff;
}

.makeup-hint {
  font-size: 22rpx;
  color: #888;
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.cal-day {
  width: 56rpx;
  height: 56rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #666;
}

.cal-day.checked {
  background: #FF6B35;
  color: #fff;
}

.cal-day.makeup {
  border: 2rpx dashed #FF6B35;
}

.cal-day.today {
  box-shadow: 0 0 0 2rpx #333 inset;
}

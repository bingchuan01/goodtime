<!-- MVP 版个人中心 -->
<navigation-bar title="个人中心" back="{{false}}" color="black" background="#FFF"></navigation-bar>

<scroll-view class="container" scroll-y>
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-header">
      <view class="avatar-wrap" bindtap="editProfile">
        <image wx:if="{{userInfo && (userInfo.avatarUrl || userInfo.avatar_url)}}" class="avatar" src="{{userInfo.avatarUrl || userInfo.avatar_url}}" mode="aspectFill"></image>
        <view wx:else class="avatar avatar-placeholder">头像</view>
      </view>
      <view class="user-info">
        <view class="nickname">{{isLoggedIn && userInfo && userInfo.nickname ? userInfo.nickname : '未登录'}}</view>
        <view class="user-id" wx:if="{{isLoggedIn}}">ID: {{userInfo && userInfo.id ? userInfo.id : '--'}}</view>
        <view class="user-id" wx:else>登录后可查看资料与发布</view>
      </view>
      <view class="edit-btn" wx:if="{{isLoggedIn}}" bindtap="editProfile">编辑</view>
    </view>
    
    <!-- MVP 统计数据：发布数、获赞、播放 -->
    <view class="stats">
      <view class="stat-item" bindtap="myProjects">
        <text class="stat-value">{{stats.projectCount}}</text>
        <text class="stat-label">发布</text>
      </view>
      <view class="stat-item" bindtap="goGrowth">
        <text class="stat-value">{{growthSummary ? growthSummary.svName : '-'}}</text>
        <text class="stat-label">成长</text>
      </view>
      <view class="stat-item" bindtap="goPointsMall">
        <text class="stat-value">{{growthSummary ? growthSummary.pointBalance : 0}}</text>
        <text class="stat-label">积分</text>
      </view>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu-list">
    <view class="menu-item" bindtap="goLogin">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/images/icons/user-menu/login.svg" mode="aspectFit" />
      </view>
      <text class="menu-text">登录/注册</text>
      <text class="menu-status">{{loginStatusText}}</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="myProjects">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/images/icons/user-menu/projects.svg" mode="aspectFit" />
      </view>
      <text class="menu-text">我的发布</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goMessages">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/images/icons/user-menu/messages.svg" mode="aspectFit" />
      </view>
      <text class="menu-text">站内信</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goGrowth">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img menu-icon-img--growth" src="/images/icons/user-menu/growth.svg" mode="aspectFit" />
      </view>
      <text class="menu-text">成长中心</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goPointsMall">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/images/icons/benefits/s-coin.svg" mode="aspectFit" />
      </view>
      <text class="menu-text">积分商城</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="memberCenter">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/images/icons/user-menu/crown.svg" mode="aspectFit" />
      </view>
      <text class="menu-text">会员权益</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goSettings">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/images/icons/user-menu/settings.svg" mode="aspectFit" />
      </view>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section" wx:if="{{isLoggedIn}}">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>
</scroll-view>

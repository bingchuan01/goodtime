<!--设置页-->
<navigation-bar title="设置" back="{{true}}" color="black" background="#FFF"></navigation-bar>

<scroll-view class="container" scroll-y>
  <view class="menu-section">
    <view class="menu-item" bindtap="changePassword">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/images/icons/user-menu/password.svg" mode="aspectFit" />
      </view>
      <text class="menu-text">修改登录密码</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="clearCache">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/images/icons/user-menu/cache.svg" mode="aspectFit" />
      </view>
      <text class="menu-text">清除缓存</text>
      <text class="menu-arrow">></text>
      <text class="menu-extra">{{cacheSize}}</text>
    </view>
    <view class="menu-item" bindtap="checkUpdate">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/images/icons/user-menu/update.svg" mode="aspectFit" />
      </view>
      <text class="menu-text">检查更新</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="aboutUs">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/images/icons/user-menu/about.svg" mode="aspectFit" />
      </view>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="privacyPolicy">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/images/icons/user-menu/privacy.svg" mode="aspectFit" />
      </view>
      <text class="menu-text">隐私协议</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="userAgreement">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/images/icons/user-menu/agreement.svg" mode="aspectFit" />
      </view>
      <text class="menu-text">用户协议</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="thirdPartyList">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/images/icons/user-menu/third-party.svg" mode="aspectFit" />
      </view>
      <text class="menu-text">第三方信息共享清单</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item menu-item-disabled" bindtap="onlineService">
      <view class="menu-icon-wrap menu-icon-wrap-muted">
        <image class="menu-icon-img" src="/images/icons/user-menu/service.svg" mode="aspectFit" />
      </view>
      <text class="menu-text">在线客服</text>
      <text class="menu-tag">敬请期待</text>
    </view>
  </view>

  <view class="menu-section danger-section">
    <view class="menu-item" bindtap="deactivateAccount">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/images/icons/user-menu/deactivate.svg" mode="aspectFit" />
      </view>
      <text class="menu-text menu-text-danger">注销账号</text>
      <text class="menu-arrow">></text>
    </view>
  </view>
</scroll-view>

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
  box-sizing: border-box;
  position: relative;
}

.top-bar {
  background: #fff;
  border-bottom: 1px solid #f0f0f0;
  padding: 16rpx 24rpx 12rpx;
}

.top-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.top-chip {
  padding: 14rpx 28rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
  line-height: 1.2;
}

.top-chip-active {
  background: #fff5f0;
  color: #ff6b35;
  font-weight: 600;
}

.active-tags {
  width: 100%;
  margin-top: 12rpx;
  white-space: nowrap;
}

.active-tags-track {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding-bottom: 4rpx;
}

.summary-chip {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  max-width: 360rpx;
  padding: 12rpx 20rpx;
  background: #fff5f0;
  border: 1px solid rgba(255, 107, 53, 0.22);
  border-radius: 32rpx;
  box-sizing: border-box;
}

.summary-chip-text {
  font-size: 24rpx;
  color: #333;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-chip-x {
  margin-left: 10rpx;
  font-size: 28rpx;
  line-height: 1;
  color: #ff6b35;
  flex-shrink: 0;
}

.filter-dropdown {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.28s ease;
  background: #fff;
  position: relative;
  z-index: 30;
  flex-shrink: 0;
}

.filter-dropdown.is-open {
  max-height: 1800rpx;
}

.body-wrap {
  flex: 1;
  min-height: 0;
  position: relative;
  display: flex;
}

.filter-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 20;
}

.filter-panel {
  background: #fff;
  border-bottom: 1px solid #f0f0f0;
  padding: 8rpx 24rpx 28rpx;
}

.filter-section {
  margin-bottom: 28rpx;
}

.filter-section:last-of-type {
  margin-bottom: 20rpx;
}

.filter-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-chip {
  width: calc(25% - 9rpx);
  box-sizing: border-box;
  padding: 18rpx 6rpx;
  background: #f5f5f5;
  border: 1px solid transparent;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #666;
  text-align: center;
  line-height: 1.35;
}

.filter-chip.active {
  background: #fff5f0;
  border-color: rgba(255, 107, 53, 0.35);
  color: #ff6b35;
  font-weight: 600;
}

.region-field {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border: 1px solid #ebebeb;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.region-field-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  opacity: 0.55;
}

.region-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 88rpx;
}

.region-placeholder {
  color: #bbb;
  font-size: 28rpx;
}

.filter-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 4rpx;
}

.btn-reset,
.btn-apply {
  flex: 1;
  text-align: center;
  padding: 22rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.2;
}

.btn-reset {
  background: #fff;
  color: #666;
  border: 1px solid #e0e0e0;
}

.btn-apply {
  background: #ff6b35;
  color: #fff;
  border: 1px solid #ff6b35;
  font-weight: 600;
}

.main {
  flex: 1;
  display: flex;
  min-height: 0;
  position: relative;
  z-index: 10;
}

.left-panel,
.right-panel {
  height: 100%;
  box-sizing: border-box;
}

.left-panel {
  width: 176rpx;
  flex-shrink: 0;
  background: #fff;
  border-right: 1px solid #f0f0f0;
}

.left-panel-inner {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.right-panel {
  flex: 1;
  min-width: 0;
  background: #f5f5f5;
}

.left-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  border-left: 6rpx solid transparent;
  color: #666;
}

.left-item.active {
  background: #fff5f0;
  border-left-color: #ff6b35;
  color: #333;
}

.left-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.left-item.active .left-icon-wrap {
  background: #fff;
}

.left-icon {
  width: 48rpx;
  height: 48rpx;
}

.left-label {
  font-size: 22rpx;
  text-align: center;
  line-height: 1.3;
}

.right-inner {
  padding: 20rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.right-title-bar {
  margin-bottom: 20rpx;
}

.right-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.l2-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.l2-chip {
  padding: 14rpx 22rpx;
  background: #fff;
  border: 1px solid #ebebeb;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
  box-sizing: border-box;
  max-width: 100%;
}

.empty-l2 {
  padding: 80rpx 40rpx;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

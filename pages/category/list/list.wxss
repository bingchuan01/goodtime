.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.filter-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1px solid #f0f0f0;
}

.filter-toggle {
  padding: 12rpx 24rpx;
  background: #f0f0f0;
  color: #666;
  font-size: 26rpx;
  border-radius: 8rpx;
}

.filter-hint {
  font-size: 22rpx;
  color: #999;
  padding: 6rpx 12rpx;
  background: #f5f5f5;
  border-radius: 6rpx;
}

.filter-panel {
  background: #fff;
  padding: 24rpx;
  border-bottom: 1px solid #f0f0f0;
}

.filter-section {
  margin-bottom: 24rpx;
}

.filter-label {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-chip {
  padding: 12rpx 20rpx;
  background: #f0f0f0;
  color: #666;
  font-size: 24rpx;
  border-radius: 8rpx;
  border: 1px solid transparent;
}

.filter-chip.active {
  background: #f0f0f0;
  color: #333;
  border-color: #ccc;
  font-weight: 600;
}

.region-input {
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.filter-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.btn-reset, .btn-apply {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.btn-reset {
  background: #f0f0f0;
  color: #666;
}

.btn-apply {
  background: #333;
  color: #fff;
}

.list-scroll {
  flex: 1;
  min-height: 0;
}

.card-list {
  padding: 20rpx;
}

.empty, .loading, .nomore {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}

.retry {
  margin-top: 16rpx;
  color: #666;
  text-decoration: underline;
}

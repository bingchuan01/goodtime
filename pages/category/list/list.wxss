.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.filter-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1px solid #f0f0f0;
}

.filter-toggle {
  padding: 14rpx 28rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
  line-height: 1.2;
}

.filter-hint {
  font-size: 24rpx;
  color: #666;
  padding: 10rpx 18rpx;
  background: #fff5f0;
  border: 1px solid rgba(255, 107, 53, 0.22);
  border-radius: 32rpx;
}

.filter-summary {
  background: #fff;
  border-bottom: 1px solid #f0f0f0;
  padding: 16rpx 0 16rpx 24rpx;
}

.filter-summary-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-summary-track {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding-right: 24rpx;
}

.summary-chip {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  max-width: 360rpx;
  padding: 12rpx 20rpx;
  background: #fff5f0;
  border: 1px solid rgba(255, 107, 53, 0.22);
  border-radius: 32rpx;
  box-sizing: border-box;
}

.summary-chip-action {
  background: #f5f5f5;
  border-color: transparent;
  color: #ff6b35;
  font-weight: 600;
}

.summary-chip-text {
  font-size: 24rpx;
  color: #333;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-dropdown {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.28s ease;
  background: #fff;
  flex-shrink: 0;
}

.filter-dropdown.is-open {
  max-height: 1800rpx;
}

.filter-panel {
  background: #fff;
  padding: 8rpx 24rpx 28rpx;
  border-bottom: 1px solid #f0f0f0;
}

.filter-section {
  margin-bottom: 28rpx;
}

.filter-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-chip {
  padding: 14rpx 22rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 24rpx;
  border-radius: 12rpx;
  border: 1px solid transparent;
  line-height: 1.35;
}

.filter-chip.active {
  background: #fff5f0;
  color: #ff6b35;
  border-color: rgba(255, 107, 53, 0.35);
  font-weight: 600;
}

.region-field {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border: 1px solid #ebebeb;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.region-field-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  opacity: 0.55;
}

.region-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 88rpx;
}

.region-placeholder {
  color: #bbb;
  font-size: 28rpx;
}

.filter-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 4rpx;
}

.btn-reset,
.btn-apply {
  flex: 1;
  text-align: center;
  padding: 22rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.2;
}

.btn-reset {
  background: #fff;
  color: #666;
  border: 1px solid #e0e0e0;
}

.btn-apply {
  background: #ff6b35;
  color: #fff;
  border: 1px solid #ff6b35;
  font-weight: 600;
}

.list-scroll {
  flex: 1;
  min-height: 0;
}

.card-list {
  padding: 20rpx;
}

.l2-section-head {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin: 8rpx 0 16rpx;
  padding-left: 8rpx;
  border-left: 6rpx solid #ff6b35;
}

.l2-section-list {
  margin-bottom: 24rpx;
}

.empty, .loading, .nomore {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}

.retry {
  margin-top: 16rpx;
  color: #ff6b35;
  text-decoration: underline;
}

<navigation-bar title="{{pageTitle}}" back="{{true}}" color="black" background="#FFF"></navigation-bar>

<view class="page">
  <view class="filter-bar">
    <view class="filter-toggle" bindtap="toggleFilter">筛选</view>
    <text class="filter-hint" wx:if="{{filters.top50}}">Top50强</text>
    <text class="filter-hint" wx:if="{{filters.priceRange}}">价格</text>
    <text class="filter-hint" wx:if="{{filters.region}}">地址</text>
  </view>

  <view class="filter-panel" wx:if="{{showFilterPanel}}">
    <view class="filter-section">
      <text class="filter-label">Top50强</text>
      <view class="filter-chip {{filters.top50 ? 'active' : ''}}" bindtap="onTop50FilterTap">热度飙升池50</view>
    </view>
    <view class="filter-section">
      <text class="filter-label">价格区间</text>
      <view class="chip-row">
        <view
          wx:for="{{priceRanges}}"
          wx:key="id"
          class="filter-chip {{filters.priceRange === item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onPriceTap"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="filter-section">
      <text class="filter-label">地址</text>
      <input class="region-input" placeholder="城市/地区关键词" value="{{regionInput}}" bindinput="onRegionInput" />
    </view>
    <view class="filter-actions">
      <view class="btn-reset" bindtap="resetFilters">重置</view>
      <view class="btn-apply" bindtap="applyFilters">确定</view>
    </view>
  </view>

  <scroll-view class="list-scroll" scroll-y bindscrolltolower="onReachBottom">
    <view class="card-list">
      <project-card
        wx:for="{{projectList}}"
        wx:key="id"
        project="{{item}}"
        bind:tap="onProjectTap"
      />
    </view>
    <view class="empty" wx:if="{{!loading && !loadError && projectList.length === 0}}">暂无项目</view>
    <view class="empty error" wx:if="{{loadError}}">
      <text>加载失败</text>
      <view class="retry" bindtap="onRetry">重试</view>
    </view>
    <view class="loading" wx:if="{{loading}}">加载中...</view>
    <view class="nomore" wx:if="{{!hasMore && projectList.length > 0}}">没有更多了</view>
  </scroll-view>
</view>

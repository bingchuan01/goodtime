<navigation-bar title="{{pageTitle}}" back="{{true}}" color="black" background="#FFF"></navigation-bar>

<view class="page">
  <view class="filter-bar" wx:if="{{!fromAllFilter}}">
    <view class="filter-toggle" bindtap="toggleFilter">筛选</view>
    <text class="filter-hint" wx:if="{{filters.typeLabel}}">{{filters.typeLabel}}</text>
    <text class="filter-hint" wx:if="{{filters.priceRange}}">额度</text>
    <text class="filter-hint" wx:if="{{filters.region}}">地址</text>
  </view>

  <view class="filter-summary" wx:if="{{fromAllFilter}}">
    <scroll-view class="filter-summary-scroll" scroll-x enable-flex>
      <view class="filter-summary-track">
        <view class="summary-chip summary-chip-action" bindtap="toggleFilter">修改筛选</view>
        <view class="summary-chip" wx:for="{{activeFilterTags}}" wx:key="key">
          <text class="summary-chip-text">{{item.label}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="filter-dropdown {{showFilterPanel && !fromAllFilter ? 'is-open' : ''}}">
    <view class="filter-panel">
      <view class="filter-section">
        <text class="filter-label">项目类型</text>
        <view class="chip-row">
          <view
            wx:for="{{filterTypes}}"
            wx:key="key"
            class="filter-chip {{filters.typeKey === item.key ? 'active' : ''}}"
            data-key="{{item.key}}"
            bindtap="onFilterTypeTap"
          >{{item.label}}</view>
        </view>
      </view>
      <view class="filter-section">
        <text class="filter-label">价格区间</text>
        <view class="chip-row">
          <view
            wx:for="{{priceRanges}}"
            wx:key="id"
            class="filter-chip {{filters.priceRange === item.id ? 'active' : ''}}"
            data-id="{{item.id}}"
            bindtap="onPriceTap"
          >{{item.label}}</view>
        </view>
      </view>
      <view class="filter-section">
        <text class="filter-label">选择城市</text>
        <view class="region-field">
          <image class="region-field-icon" src="/images/icons/location-pin.svg" mode="aspectFit" />
          <input
            class="region-input"
            placeholder="请输入项目所在地址/城市名称"
            placeholder-class="region-placeholder"
            value="{{regionInput}}"
            bindinput="onRegionInput"
          />
        </view>
      </view>
      <view class="filter-actions">
        <view class="btn-reset" bindtap="resetFilters">重置</view>
        <view class="btn-apply" bindtap="applyFilters">确定</view>
      </view>
    </view>
  </view>

  <scroll-view class="list-scroll" scroll-y bindscrolltolower="onReachBottom">
    <view class="card-list" wx:if="{{groupByL2}}">
      <block wx:for="{{l2Sections}}" wx:key="name" wx:for-item="section">
        <view class="l2-section-head">{{section.name}}</view>
        <view class="l2-section-list">
          <project-card
            wx:for="{{section.projects}}"
            wx:key="id"
            wx:for-item="project"
            project="{{project}}"
            bind:tap="onProjectTap"
          />
        </view>
      </block>
      <view class="empty" wx:if="{{!loading && !loadError && l2Sections.length === 0}}">暂无项目</view>
    </view>

    <view class="card-list" wx:else>
      <project-card
        wx:for="{{projectList}}"
        wx:key="id"
        project="{{item}}"
        bind:tap="onProjectTap"
      />
      <view class="empty" wx:if="{{!loading && !loadError && projectList.length === 0}}">暂无项目</view>
    </view>

    <view class="empty error" wx:if="{{loadError}}">
      <text>加载失败</text>
      <view class="retry" bindtap="onRetry">重试</view>
    </view>
    <view class="loading" wx:if="{{loading}}">加载中...</view>
    <view class="nomore" wx:if="{{!hasMore && ((groupByL2 && l2Sections.length > 0) || (!groupByL2 && projectList.length > 0))}}">没有更多了</view>
  </scroll-view>
</view>

/**search-bar.wxss**/
.search-bar-panel {
  background-color: #fff;
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx 20rpx 20rpx;
  gap: 12rpx;
}

.location-picker {
  flex: none;
  max-width: 180rpx;
}

.location-block {
  display: flex;
  align-items: center;
  padding-right: 4rpx;
}

.location-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.location-text {
  margin-left: 6rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  max-width: 96rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-arrow {
  width: 20rpx;
  height: 20rpx;
  margin-left: 2rpx;
  flex-shrink: 0;
  opacity: 0.75;
}

.search-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.search-input-wrapper {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 50rpx;
  padding: 18rpx 24rpx;
  margin-right: 16rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.icon-placeholder {
  margin-right: 16rpx;
  font-size: 28rpx;
  flex-shrink: 0;
}

.placeholder {
  font-size: 28rpx;
  color: #999;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-btn {
  flex: none;
  font-size: 28rpx;
  color: #ff6b35;
  padding-left: 16rpx;
  border-left: 1px solid #e0e0e0;
}

/* root-portal 内：选择城市 */
.loc-portal-wrap {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 9999;
}

.loc-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.loc-region-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.loc-region-title {
  text-align: center;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.loc-region-btn {
  padding: 28rpx;
  text-align: center;
  font-size: 32rpx;
  color: #ff6b35;
  font-weight: 600;
  background: #fff5f0;
  border-radius: 16rpx;
}

.loc-region-cancel {
  margin-top: 20rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 30rpx;
  color: #666;
}

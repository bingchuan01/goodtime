/**category-nav.wxss**/
.category-nav {
  width: 100%;
  height: 200rpx;
  white-space: nowrap;
  padding: 20rpx 0;
  box-sizing: border-box;
  background-color: #fff;
}

.category-track {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  height: 100%;
  padding: 0 8rpx 0 16rpx;
  min-width: max-content;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin: 0 20rpx;
  padding: 10rpx;
  flex-shrink: 0;
}

.icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.category-item.active .icon-wrapper {
  background-color: #FFF5F0;
}

/* 图标比圆底小 0.2 倍（×0.8），避免贴边像凸出圆外 */
.icon {
  width: 64rpx;
  height: 64rpx;
}

.icon-fallback {
  font-size: 38rpx;
  line-height: 38rpx;
}

.label {
  font-size: 24rpx;
  color: #666;
  white-space: nowrap;
}

.category-item.active .label {
  color: #FF6B35;
  font-weight: bold;
}
